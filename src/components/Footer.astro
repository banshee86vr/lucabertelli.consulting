---
import { getServices } from "../content/config";
import { servicePath, servicesHubPath } from "../constants/services";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import type { UiLang } from "../utils/seo";

const lang = getLangFromUrl(Astro.url) as UiLang;
const t = useTranslations(lang);
const privacyUrl = `/${lang}/privacy`;
const cookiesUrl = `/${lang}/cookies`;

const services = (await getServices(lang)).map((service) => ({
  title: service.data.title,
  href: servicePath(service.data.key, lang),
}));
---

<footer class="footer__area pb-0">
  <div class="footer__top">
    <div class="container line g-0">
      <div class="row">
        <div class="col-xxl-3 col-xl-3 col-lg-3">
          <div class="footer__logo">
            <a href={`/${lang}`}
              ><img
                src="/logo.png"
                class="show-dark"
                alt={t("a11y.logo")}
                style="max-height: 75px;"
              /></a
            >
          </div>
        </div>
        <div class="col-xxl-9 col-xl-9 col-lg-9">
          <div class="footer__info">
            <div class="footer__email">
              <h3 class="footer__title">{t('contact.email')}</h3>
              <a href="mailto:info@lucabertelli.consulting" class="footer__link"
                >info@lucabertelli.consulting</a
              >
            </div>
            <div class="footer__social">
              <h3 class="footer__title">{t('footer.follow')}</h3>
              <ul class="hover-zoom">
                <li>
                  <a href="https://github.com/banshee86vr" target="_blank" rel="noopener noreferrer" aria-label={t("a11y.social.github")}><i class="fa-brands fa-github" aria-hidden="true"></i></a>
                </li>
                <li>
                  <a href="https://www.linkedin.com/in/luca-bertelli-a1413b77" target="_blank" rel="noopener noreferrer" aria-label={t("a11y.social.linkedin")}><i class="fa-brands fa-linkedin" aria-hidden="true"></i></a>
                </li>
                <li>
                  <a href="https://medium.com/@bertelli.luca" target="_blank" rel="noopener noreferrer" aria-label={t("a11y.social.medium")}><i class="fa-brands fa-medium" aria-hidden="true"></i></a>
                </li>
                <li>
                  <a href="https://www.credly.com/users/luca-bertelli" target="_blank" rel="noopener noreferrer" aria-label={t("a11y.social.credly")}><i class="fa-solid fa-c" aria-hidden="true"></i></a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="footer__services">
    <div class="container">
      <nav aria-label={t("nav.services")}>
        <h2 class="footer__title">
          <a href={servicesHubPath(lang)} class="footer__services-hub">{t("nav.services")}</a>
        </h2>
        <ul class="footer__services-list">
          {
            services.map((service) => (
              <li>
                <a href={service.href}>{service.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
  <div class="footer__btm">
    <div class="container">
      <div class="row">
        <div class="col-xxl-12">
          <div class="copyright">
            <p>
              © {new Date().getFullYear()} | {t('footer.copyrightReserved')}{' '}
              <a href="https://lucabertelli.consulting">lucabertelli.consulting</a>
              {' '}| CF/P.IVA: 05028510237
            </p>
            <p class="footer__legal">
              <a href={privacyUrl} class="footer__legal-link" title={t('footer.privacy')}>{t('footer.privacy')}</a>
              <span class="footer__legal-separator">|</span>
              <a href={cookiesUrl} class="footer__legal-link" title={t('footer.cookies')}>{t('footer.cookies')}</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer__services {
    padding: 32px 0;
  }

  .footer__services-hub {
    color: inherit;
    text-decoration: none;
  }

  .footer__services-hub:hover,
  .footer__services-hub:focus-visible {
    color: var(--primary);
  }

  .footer__services-list li {
    /* master.css sets `li { list-style: decimal }` globally */
    list-style: none;
  }

  .footer__services-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
  }

  .footer__services-list a {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--white-3);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer__services-list a:hover,
  .footer__services-list a:focus-visible {
    color: var(--primary);
  }

  .footer__services-list a:focus-visible,
  .footer__services-hub:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .light .footer__services-list a {
    color: var(--black-2);
  }

  .footer__legal {
    margin-top: 10px;
  }

  .footer__legal-link {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    color: var(--white-3);
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s ease;
    text-decoration: none;
  }

  .footer__legal-link:hover,
  .footer__legal-link:focus-visible {
    color: var(--primary);
  }

  .footer__legal-link:focus-visible,
  .footer__link:focus-visible,
  .footer__social a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .light .footer__legal-link {
    color: var(--black-2);
  }

  .light .footer__legal-link:hover,
  .light .footer__legal-link:focus-visible {
    color: var(--primary);
  }

  .footer__legal-separator {
    color: var(--white-3);
    margin: 0 10px;
    opacity: 0.5;
  }

  .light .footer__legal-separator {
    color: var(--black-2);
  }
</style>
