---
import ServiceIcon from "./ServiceIcon.astro";
import { getServices } from "../content/config";
import {
  SERVICE_ICONS,
  servicePath,
  servicesHubPath,
} from "../constants/services";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import type { UiLang } from "../utils/seo";

const lang = getLangFromUrl(Astro.url) as UiLang;
const t = useTranslations(lang);

const services = (await getServices(lang)).map((service) => {
  const key = service.data.key;
  return {
    key,
    title: service.data.title,
    text: service.data.tagline,
    href: servicePath(key, lang),
    icon: SERVICE_ICONS[key],
  };
});
---

<section class="lb-ins__area pb-100">
  <div class="container">
    <div class="lb-inp__project-sec-title-wrap">
      <h2 class="lb-inp__project-title">
        {t("index.services.title")}
      </h2>
      <p class="services-subtitle">{t("index.services.subtitle")}</p>
    </div>

    <div class="services-grid" style="margin-top: 60px;">
      {services.map((service) => (
        <article class="service-card">
          <div class="service-card__icon">
            <ServiceIcon name={service.icon} />
          </div>
          <h3 class="service-card__title">
            <a href={service.href}>{service.title}</a>
          </h3>
          <p class="service-card__text">{service.text}</p>
          <span class="service-card__cta" aria-hidden="true">
            {t("index.services.cardCta")}
          </span>
        </article>
      ))}
    </div>

    <p class="services-all">
      <a href={servicesHubPath(lang)} class="services-all__link">
        {t("index.services.cta")}
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    </p>
  </div>
</section>

<style>
  .services-subtitle {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 1.0625rem;
    line-height: 1.7;
    max-width: 62ch;
    margin-top: 1.25rem;
    color: var(--gray-4);
  }

  :global(.light) .services-subtitle {
    color: var(--gray);
  }

  .services-grid {
    display: grid;
    gap: 24px;
  }

  /* Desktop: 4 + 4 on a 12-column track */
  @media (min-width: 992px) {
    .services-grid {
      grid-template-columns: repeat(12, 1fr);
    }

    .service-card:nth-child(1),
    .service-card:nth-child(5) {
      grid-column: 1 / 4;
    }
    .service-card:nth-child(2),
    .service-card:nth-child(6) {
      grid-column: 4 / 7;
    }
    .service-card:nth-child(3),
    .service-card:nth-child(7) {
      grid-column: 7 / 10;
    }
    .service-card:nth-child(4),
    .service-card:nth-child(8) {
      grid-column: 10 / 13;
    }
  }

  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 32px 28px;
    border-radius: 12px;
    background: linear-gradient(
      168deg,
      var(--black-4) 0%,
      var(--black-3) 100%
    );
    border: 1px solid var(--black-6);
    transition: border-color 0.2s ease;
  }

  .service-card:hover {
    border-color: var(--primary);
  }

  .service-card__icon {
    width: 72px;
    height: 72px;
    margin-bottom: 24px;
    flex-shrink: 0;
    color: var(--primary);
  }

  .service-card__icon :global(.service-icon__svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .service-card:hover .service-card__icon {
    color: var(--primary);
    filter: brightness(1.08);
  }

  :global(.light) .service-card__icon {
    color: var(--secondary);
  }

  :global(.light) .service-card:hover .service-card__icon {
    color: var(--secondary);
    filter: none;
  }

  .service-card__title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--white);
    margin-bottom: 16px;
    min-height: 2.6em;
  }

  .service-card__title a {
    color: inherit;
    text-decoration: none;
  }

  /* Stretched link keeps the whole card clickable without nesting anchors */
  .service-card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .service-card__title a:hover,
  .service-card__title a:focus-visible {
    color: var(--primary);
  }

  .service-card__title a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 4px;
  }

  .service-card__text {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--gray-4);
    margin: 0 0 18px;
    padding: 0;
    flex: 1;
  }

  .service-card__cta {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--primary);
  }

  :global(.light) .service-card__cta {
    color: var(--secondary);
  }

  .services-all {
    margin-top: 48px;
    text-align: center;
  }

  .services-all__link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 1.0625rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .services-all__link:hover,
  .services-all__link:focus-visible {
    color: var(--primary);
  }

  .services-all__link:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }

  :global(.light) .service-card {
    background: linear-gradient(
      168deg,
      var(--white-3) 0%,
      rgba(255, 255, 255, 0) 100%
    );
    border-color: var(--gray-13);
  }

  :global(.light) .service-card:hover {
    background-color: var(--white-3);
    border-color: var(--secondary);
  }

  :global(.light) .service-card__title {
    color: var(--black-2);
  }

  :global(.light) .service-card__text {
    color: var(--gray);
  }

  @media (max-width: 1199px) {
    .service-card {
      padding: 28px 24px;
    }

    .service-card__title {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 991px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .service-card:nth-child(n) {
      grid-column: auto;
    }

    .service-card__title {
      min-height: unset;
    }
  }

  @media (max-width: 575px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .service-card {
      padding: 24px 20px;
    }
  }
</style>
