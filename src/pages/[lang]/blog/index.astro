---
import BaseLayout from "../../../layouts/Common.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import { getBlogPosts } from "../../../content/config";
import Tickets from "../../../components/Tickets.astro";
import { absoluteUrl } from "../../../utils/seo";
import type { UiLang } from "../../../utils/seo";
import { tagLabel, tagPath, tagSlug } from "../../../utils/tags";
import { buildBlog, buildBreadcrumbs } from "../../../utils/jsonLd";
import { readingMinutes, wordCountFromBody } from "../../../utils/readingTime";

export const prerender = true;

export async function getStaticPaths() {
  return ["en", "it"].map((lang) => {
    return { params: { lang } };
  });
}

const lang = getLangFromUrl(Astro.url) as UiLang;
const t = useTranslations(lang);
const dateLocale = lang === "it" ? "it-IT" : "en-US";
const cardWidths = [320, 480, 640];
const appendImageParams = (url: string, params: string) =>
  `${url}${url.includes("?") ? "&" : "?"}${params}`;
const buildSrcSet = (url: string, widths: number[], format?: "webp") =>
  widths
    .map((width) => {
      const query = format ? `format=${format}&w=${width}` : `w=${width}`;
      return `${appendImageParams(url, query)} ${width}w`;
    })
    .join(", ");

const posts = (await getBlogPosts())
  .filter((blog) => blog?.data?.lang === lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Distinct tags of this language, so the listing links to real tag pages
// rather than to query-string filters that a static build cannot honour.
const tags = [
  ...new Map(
    posts
      .flatMap((post) => post.data.tags as string[])
      .map((tag) => [tagSlug(tag), tag]),
  ).values(),
].sort((a, b) => tagLabel(a).localeCompare(tagLabel(b), dateLocale));

const blogPath = `/${lang}/blog`;
const blogUrl = absoluteUrl(blogPath);

const jsonLdExtra = [
  buildBlog({
    name: t("seo.blog.title"),
    description: t("seo.blog.description"),
    url: blogUrl,
    lang,
    posts: posts.map((post) => ({
      name: post.data.title as string,
      url: absoluteUrl(`/${lang}/blog/${post.blog_slug}`),
    })),
  }),
  ...buildBreadcrumbs([
    { name: t("nav.home"), url: absoluteUrl(`/${lang}`) },
    { name: t("nav.blog"), url: blogUrl },
  ]),
];
---

<BaseLayout
  title={t("seo.blog.title")}
  description={t("seo.blog.description")}
  jsonLdExtra={jsonLdExtra}
>
  <div class="main-blog__area pt-120 pb-120">
    <div class="container ptf-0">
      <div class="row">
        <div class="col-xxl-12">
          <Breadcrumbs
            items={[{ name: t("nav.home"), href: `/${lang}` }, { name: t("nav.blog") }]}
          />

          <h1 class="sec-title blog-index__h1 mb-20">{t("blog.index.heading")}</h1>
          <p class="lb-blog__intro">{t("blog.index.intro")}</p>

          <nav class="lb-blog__tags" aria-label={t("blog.tags.title")}>
            <h2 class="lb-blog__tags-title">{t("blog.tags.title")}</h2>
            <ul>
              {
                tags.map((tag) => (
                  <li>
                    <a href={tagPath(tag, lang)}>{tagLabel(tag)}</a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <div class="main-blog__grid">
            {
              posts.map((post) => {
                const minutes = readingMinutes(wordCountFromBody(post.body));
                return (
                  <article class="lb-blog__item blog-img-zoom">
                    <a class="lb-blog__card" href={`/${lang}/blog/${post.blog_slug}`}>
                      <div class="thumb">
                        <picture>
                          <source
                            type="image/webp"
                            srcset={buildSrcSet(post.data.image, cardWidths, "webp")}
                            sizes="(max-width: 767px) 100vw, 50vw"
                          />
                          <source
                            srcset={buildSrcSet(post.data.image, cardWidths)}
                            sizes="(max-width: 767px) 100vw, 50vw"
                          />
                          <img
                            src={appendImageParams(post.data.image, "w=480")}
                            srcset={buildSrcSet(post.data.image, cardWidths)}
                            alt=""
                            width={800}
                            height={450}
                            sizes="(max-width: 767px) 100vw, 50vw"
                            loading="lazy"
                            decoding="async"
                          />
                        </picture>
                      </div>
                      <ul class="lb-blog__meta">
                        <li>
                          <time datetime={post.data.date.toISOString()}>
                            {post.data.date.toLocaleString(dateLocale, {
                              year: "numeric",
                              month: "short",
                              day: "numeric",
                            })}
                          </time>
                        </li>
                        <li>{t("post.readingTime").replace("{n}", String(minutes))}</li>
                      </ul>
                      <h2 class="lb-blog__title">{post.data.title}</h2>
                      <p class="lb-blog__excerpt">{post.data.subtitle}</p>
                    </a>
                  </article>
                );
              })
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <Tickets />
</BaseLayout>

<style>
  .lb-blog__intro {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 1.0625rem;
    line-height: 1.7;
    max-width: 62ch;
    color: var(--gray-4);
    margin-bottom: 2.5rem;
  }

  :global(.light) .lb-blog__intro {
    color: var(--gray);
  }

  .lb-blog__tags {
    margin-bottom: 3.5rem;
  }

  .lb-blog__tags-title {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gray-4);
    margin-bottom: 1rem;
  }

  .lb-blog__tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* master.css sets `li { list-style: decimal }` globally */
  .lb-blog__tags li {
    list-style: none;
  }

  .lb-blog__tags a {
    display: inline-block;
    padding: 0.45rem 0.95rem;
    border-radius: 4px;
    border: 1px solid var(--black-6);
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  :global(.light) .lb-blog__tags a {
    border-color: var(--gray-13);
  }

  .lb-blog__tags a:hover,
  .lb-blog__tags a:focus-visible {
    border-color: var(--primary);
    color: var(--primary);
  }

  .lb-blog__tags a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
</style>
