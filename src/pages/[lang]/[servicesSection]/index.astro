---
import BaseLayout from "../../../layouts/Common.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import InsightCards from "../../../components/InsightCards.astro";
import ServiceIcon from "../../../components/ServiceIcon.astro";
import Tickets from "../../../components/Tickets.astro";

import { getInsights, getServices } from "../../../content/config";
import {
  INSIGHT_KEYS,
  insightPath,
} from "../../../constants/insights";
import {
  SERVICES_SECTION_SLUG,
  SERVICE_ICONS,
  SERVICE_KEYS,
  servicePath,
  servicesHubPath,
  type ServiceKey,
} from "../../../constants/services";
import { useTranslations } from "../../../i18n/utils";
import { absoluteUrl } from "../../../utils/seo";
import type { UiLang } from "../../../utils/seo";
import {
  buildBreadcrumbs,
  buildCollectionPage,
  buildServiceOffers,
} from "../../../utils/jsonLd";

export const prerender = true;

export async function getStaticPaths() {
  return (["en", "it"] as UiLang[]).map((lang) => ({
    params: { lang, servicesSection: SERVICES_SECTION_SLUG[lang] },
  }));
}

const lang = Astro.params.lang as UiLang;
const t = useTranslations(lang);

const services = await getServices(lang);
const hubPath = servicesHubPath(lang);
const hubUrl = absoluteUrl(hubPath);

const cards = services.map((service) => {
  const key = service.data.key;
  return {
    key,
    title: service.data.title,
    tagline: service.data.tagline,
    href: servicePath(key, lang),
    icon: SERVICE_ICONS[key],
  };
});

const breadcrumbItems = [
  { name: t("nav.home"), href: `/${lang}` },
  { name: t("nav.services") },
];

const jsonLdExtra = [
  buildCollectionPage({
    name: t("services.hub.h1"),
    description: t("services.hub.seoDescription"),
    url: hubUrl,
    lang,
    items: cards.map((card) => ({
      name: card.title,
      url: absoluteUrl(card.href),
    })),
  }),
  ...buildServiceOffers(
    services.map((service) => ({
      name: service.data.title,
      description: service.data.description,
      url: absoluteUrl(servicePath(service.data.key, lang)),
    })),
    lang,
  ),
  ...buildBreadcrumbs([
    { name: t("nav.home"), url: absoluteUrl(`/${lang}`) },
    { name: t("nav.services"), url: hubUrl },
  ]),
];

const keywords = services.flatMap(
  (service) => service.data.keywords as string[],
);

const intentCopyByService: Record<
  ServiceKey,
  { title: Parameters<typeof t>[0]; text: Parameters<typeof t>[0] }
> = {
  devops: {
    title: "services.hub.intent.devops.title",
    text: "services.hub.intent.devops.text",
  },
  cloud: {
    title: "services.hub.intent.cloud.title",
    text: "services.hub.intent.cloud.text",
  },
  "platform-engineering": {
    title: "services.hub.intent.platform.title",
    text: "services.hub.intent.platform.text",
  },
  kubernetes: {
    title: "services.hub.intent.kubernetes.title",
    text: "services.hub.intent.kubernetes.text",
  },
  secdevops: {
    title: "services.hub.intent.secdevops.title",
    text: "services.hub.intent.secdevops.text",
  },
  training: {
    title: "services.hub.intent.training.title",
    text: "services.hub.intent.training.text",
  },
  "ai-engineering": {
    title: "services.hub.intent.ai.title",
    text: "services.hub.intent.ai.text",
  },
};

const intents = SERVICE_KEYS.map((key) => {
  const copy = intentCopyByService[key];
  return {
    key,
    title: t(copy.title),
    text: t(copy.text),
    href: servicePath(key, lang),
    serviceTitle:
      services.find((service) => service.data.key === key)?.data.title ?? key,
  };
});

const hubArticles = (await getInsights(lang))
  .sort(
    (a, b) =>
      INSIGHT_KEYS.indexOf(a.data.key) - INSIGHT_KEYS.indexOf(b.data.key),
  )
  .map((entry) => ({
    title: entry.data.title,
    subtitle: entry.data.subtitle,
    href: insightPath(entry.data.key, lang),
  }));
---

<BaseLayout
  title={t("services.hub.seoTitle")}
  description={t("services.hub.seoDescription")}
  keywords={keywords}
  jsonLdExtra={jsonLdExtra}
>
  <section class="lb-services-hub pt-120 pb-100">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />

      <h1 class="lb-services-hub__title">{t("services.hub.h1")}</h1>
      <p class="lb-services-hub__intro">{t("services.hub.intro")}</p>

      <div class="lb-services-hub__grid">
        {
          cards.map((card) => (
            <article class="lb-service-card">
              <div class="lb-service-card__icon">
                <ServiceIcon name={card.icon} />
              </div>
              <h2 class="lb-service-card__title">
                <a href={card.href}>{card.title}</a>
              </h2>
              <p class="lb-service-card__text">{card.tagline}</p>
              <span class="lb-service-card__cta" aria-hidden="true">
                {t("index.services.cardCta")}
              </span>
            </article>
          ))
        }
      </div>

      <section class="lb-services-intents" aria-labelledby="services-intents-title">
        <h2 id="services-intents-title" class="lb-services-intents__title">
          {t("services.hub.intents.title")}
        </h2>
        <p class="lb-services-intents__intro">{t("services.hub.intents.intro")}</p>
        <ul class="lb-services-intents__list">
          {
            intents.map((intent) => (
              <li>
                <h3 class="lb-services-intents__item-title">
                  <a href={intent.href}>{intent.title}</a>
                </h3>
                <p class="lb-services-intents__item-text">{intent.text}</p>
                <a class="lb-services-intents__link" href={intent.href}>
                  {intent.serviceTitle}
                  <i class="fa-solid fa-arrow-right" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      {
        hubArticles.length > 0 && (
          <section
            class="lb-services-insights"
            aria-labelledby="services-insights-title"
          >
            <h2 id="services-insights-title" class="lb-services-insights__title">
              {t("services.hub.insights.title")}
            </h2>
            <p class="lb-services-insights__intro">
              {t("services.hub.insights.intro")}
            </p>
            <InsightCards
              items={hubArticles}
              ctaLabel={t("index.services.cardCta")}
              headingLevel={3}
            />
          </section>
        )
      }

      <div class="lb-services-cta">
        <h2 class="lb-services-cta__title">{t("services.cta.title")}</h2>
        <p class="lb-services-cta__text">{t("services.cta.text")}</p>
        <a
          class="wc-btn-primary btn-rollover-top"
          href="mailto:info@lucabertelli.consulting"
        >
          {t("services.cta.button")}
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>

  <Tickets />
</BaseLayout>

<style>
  .lb-services-hub__title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
  }

  .lb-services-hub__intro {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 1.125rem;
    line-height: 1.7;
    max-width: 62ch;
    color: var(--gray-4);
    margin-bottom: 3.5rem;
  }

  :global(.light) .lb-services-hub__intro {
    color: var(--gray);
  }

  .lb-services-hub__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .lb-service-card {
    display: flex;
    flex-direction: column;
    padding: 32px 28px;
    border-radius: 12px;
    background: linear-gradient(168deg, var(--black-4) 0%, var(--black-3) 100%);
    border: 1px solid var(--black-6);
    transition: border-color 0.2s ease;
  }

  .lb-service-card:hover,
  .lb-service-card:focus-within {
    border-color: var(--primary);
  }

  .lb-service-card__icon {
    width: 60px;
    height: 60px;
    margin-bottom: 20px;
    color: var(--primary);
  }

  .lb-service-card__icon :global(.service-icon__svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global(.light) .lb-service-card__icon {
    color: var(--secondary);
  }

  .lb-service-card__title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }

  .lb-service-card__title a {
    color: var(--white);
    text-decoration: none;
  }

  /* Stretched link keeps the whole card clickable without nesting anchors */
  .lb-service-card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .lb-service-card {
    position: relative;
  }

  .lb-service-card__title a:hover,
  .lb-service-card__title a:focus-visible {
    color: var(--primary);
  }

  .lb-service-card__title a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 4px;
  }

  .lb-service-card__text {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--gray-4);
    margin: 0 0 20px;
    flex: 1;
  }

  .lb-service-card__cta {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--primary);
  }

  :global(.light) .lb-service-card {
    background: linear-gradient(168deg, var(--white-3) 0%, rgba(255, 255, 255, 0) 100%);
    border-color: var(--gray-13);
  }

  :global(.light) .lb-service-card__title a {
    color: var(--black-2);
  }

  :global(.light) .lb-service-card__text {
    color: var(--gray);
  }

  :global(.light) .lb-service-card__cta {
    color: var(--secondary);
  }

  .lb-services-intents {
    margin-top: 5rem;
    max-width: 72ch;
  }

  .lb-services-intents__title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .lb-services-intents__intro {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--gray-4);
    margin-bottom: 2.5rem;
  }

  :global(.light) .lb-services-intents__intro {
    color: var(--gray);
  }

  .lb-services-intents__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  .lb-services-intents__item-title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }

  .lb-services-intents__item-title a {
    color: var(--white);
    text-decoration: none;
  }

  .lb-services-intents__item-title a:hover,
  .lb-services-intents__item-title a:focus-visible {
    color: var(--primary);
  }

  :global(.light) .lb-services-intents__item-title a {
    color: var(--black-2);
  }

  .lb-services-intents__item-text {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 0.975rem;
    line-height: 1.65;
    color: var(--gray-4);
    margin: 0 0 0.75rem;
  }

  :global(.light) .lb-services-intents__item-text {
    color: var(--gray);
  }

  .lb-services-intents__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--primary);
    text-decoration: none;
  }

  .lb-services-intents__link:hover,
  .lb-services-intents__link:focus-visible {
    text-decoration: underline;
  }

  :global(.light) .lb-services-intents__link {
    color: var(--secondary);
  }

  .lb-services-insights {
    margin-top: 5rem;
  }

  .lb-services-insights__title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .lb-services-insights__intro {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 1.0625rem;
    line-height: 1.7;
    max-width: 62ch;
    color: var(--gray-4);
    margin-bottom: 2.5rem;
  }

  :global(.light) .lb-services-insights__intro {
    color: var(--gray);
  }

  .lb-services-cta {
    margin-top: 4rem;
    padding: 48px 40px;
    border-radius: 12px;
    border: 1px solid var(--black-6);
    text-align: center;
  }

  :global(.light) .lb-services-cta {
    border-color: var(--gray-13);
  }

  .lb-services-cta__title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .lb-services-cta__text {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 56ch;
    margin: 0 auto 2rem;
    color: var(--gray-4);
  }

  :global(.light) .lb-services-cta__text {
    color: var(--gray);
  }

  @media (max-width: 991px) {
    .lb-services-hub__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 575px) {
    .lb-services-hub__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .lb-services-cta {
      padding: 32px 24px;
    }
  }
</style>
