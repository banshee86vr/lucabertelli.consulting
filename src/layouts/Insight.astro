---
import BaseLayout from "./Common.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Tickets from "../components/Tickets.astro";

import { getInsights, getServices } from "../content/config";
import type { InsightKey } from "../constants/insights";
import { insightPath, insightsHubPath } from "../constants/insights";
import { servicePath } from "../constants/services";
import type { ServiceKey } from "../constants/services";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { absoluteUrl } from "../utils/seo";
import { buildBlogPosting, buildBreadcrumbs } from "../utils/jsonLd";
import { readingMinutes, wordCountFromBody } from "../utils/readingTime";
import type { UiLang } from "../utils/seo";

interface Props {
	title: string;
	subtitle: string;
	seoTitle: string;
	date: Date;
	updated?: Date;
	image: string;
	lang: UiLang;
	insightKey: InsightKey;
	relatedServices: ServiceKey[];
	wordCount?: number;
}

const {
	title,
	subtitle,
	seoTitle,
	date,
	updated,
	image,
	lang,
	insightKey,
	relatedServices: relatedServiceKeys,
	wordCount = 0,
} = Astro.props;

const currentLang = getLangFromUrl(Astro.url) as UiLang;
const t = useTranslations(currentLang);
const dateLocale = lang === "it" ? "it-IT" : "en-US";
const minutes = readingMinutes(wordCount);
const readingLabel = t("post.readingTime").replace("{n}", String(minutes));
const category = t("insights.category");

const hubPath = insightsHubPath(lang);
const canonicalUrl = absoluteUrl(insightPath(insightKey, lang));

const articleLd = buildBlogPosting({
	headline: title,
	description: subtitle,
	datePublished: date,
	dateModified: updated,
	image,
	url: canonicalUrl,
	inLanguage: lang,
	keywords: relatedServiceKeys,
	articleSection: category,
	wordCount,
});

const relatedServices = (await getServices(lang))
	.filter((service) => relatedServiceKeys.includes(service.data.key))
	.map((service) => ({
		title: service.data.title,
		tagline: service.data.tagline,
		href: servicePath(service.data.key, lang),
	}));

const otherInsights = (await getInsights(lang))
	.filter((entry) => entry.data.key !== insightKey)
	.slice(0, 3)
	.map((entry) => {
		const words = wordCountFromBody(String(entry.body ?? ""));
		return {
			title: entry.data.title,
			image: entry.data.image,
			date: entry.data.date,
			href: insightPath(entry.data.key, lang),
			readingLabel: t("post.readingTime").replace(
				"{n}",
				String(readingMinutes(words)),
			),
		};
	});

const jsonLdExtra = [
	articleLd,
	...buildBreadcrumbs([
		{ name: t("nav.home"), url: absoluteUrl(`/${lang}`) },
		{ name: t("nav.insights"), url: absoluteUrl(hubPath) },
		{ name: title, url: canonicalUrl },
	]),
];

const heroWidths = [480, 768, 1200];
const cardWidths = [320, 480, 640];
const appendImageParams = (url: string, params: string) =>
	`${url}${url.includes("?") ? "&" : "?"}${params}`;
const buildSrcSet = (url: string, widths: number[], format?: "webp") =>
	widths
		.map((width) => {
			const query = format ? `format=${format}&w=${width}` : `w=${width}`;
			return `${appendImageParams(url, query)} ${width}w`;
		})
		.join(", ");

const formatDate = (value: Date) =>
	value.toLocaleDateString(dateLocale, {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
---

<BaseLayout
  title={seoTitle}
  description={subtitle}
  ogImage={image}
  ogType="article"
  canonical={canonicalUrl}
  articlePublishedTime={date.toISOString()}
  articleModifiedTime={(updated ?? date).toISOString()}
  articleSection={category}
  keywords={relatedServiceKeys}
  jsonLdExtra={jsonLdExtra}
>
  <section class="blog__details__area pt-120 pb-30">
    <div class="container">
      <div class="row">
        <div class="col-xxl-12">
          <Breadcrumbs
            items={[
              { name: t("nav.home"), href: `/${lang}` },
              { name: t("nav.insights"), href: hubPath },
              { name: title },
            ]}
          />
        </div>
      </div>
      <div class="row">
        <div class="col-xxl-12">
          <div class="blog__details-top cf_parallax_image">
            <picture>
              <source
                type="image/webp"
                srcset={buildSrcSet(image, heroWidths, "webp")}
                sizes="(max-width: 991px) 100vw, 1200px"
              />
              <source
                srcset={buildSrcSet(image, heroWidths)}
                sizes="(max-width: 991px) 100vw, 1200px"
              />
              <img
                class="blog__details-hero-img"
                src={appendImageParams(image, "w=768")}
                srcset={buildSrcSet(image, heroWidths)}
                sizes="(max-width: 991px) 100vw, 1200px"
                alt=""
                width="1200"
                height="675"
                fetchpriority="high"
                decoding="async"
                data-speed="0.9"
              />
            </picture>
          </div>

          <div class="blog__details-wrap">
            <div class="blog__details-info">
              <ul class="blog__meta">
                <li>
                  <span class="blog__meta-label">{t("post.header.category")}</span>
                  <span class="blog__meta-value">{category}</span>
                </li>
                <li>
                  <span class="blog__meta-label">{t("post.header.date")}</span>
                  <time
                    class="blog__meta-value"
                    datetime={date.toISOString()}
                  >
                    {formatDate(date)}
                  </time>
                </li>
                {
                  updated && (
                    <li>
                      <span class="blog__meta-label">{t("post.header.updated")}</span>
                      <time
                        class="blog__meta-value"
                        datetime={updated.toISOString()}
                      >
                        {formatDate(updated)}
                      </time>
                    </li>
                  )
                }
                <li>
                  <span class="blog__meta-label">{t("post.header.readingTime")}</span>
                  <span class="blog__meta-value">{readingLabel}</span>
                </li>
              </ul>
              <h1 class="blog__details_title">
                {title}
              </h1>
              <p class="blog__details_subtitle">{subtitle}</p>
            </div>

            <div class="blog__details">
              <slot />
            </div>

            {
              relatedServices.length > 0 && (
                <aside class="lb-post__services">
                  <h2 class="lb-post__services-title">{t("insights.services.title")}</h2>
                  <p class="lb-post__services-text">{t("insights.services.text")}</p>
                  <ul class="lb-post__services-list">
                    {relatedServices.map((service) => (
                      <li>
                        <a href={service.href}>
                          <strong>{service.title}</strong>
                          <span>{service.tagline}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </aside>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    otherInsights.length > 0 && (
      <section class="blog__related pb-120">
        <div class="container">
          <div class="row">
            <div class="col-xxl-12">
              <div class="sec-title-wrapper pt-120">
                <h2 class="sec-sub-title mb-20">{t("insights.related.eyebrow")}</h2>
                <h3 class="sec-title">{t("insights.related.title")}</h3>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-xxl-12">
              <div class="blog__related-grid">
                {otherInsights.map((item) => (
                  <article class="lb-blog__item blog-img-zoom">
                    <a class="lb-blog__card" href={item.href}>
                      <div class="thumb">
                        <picture>
                          <source
                            type="image/webp"
                            srcset={buildSrcSet(item.image, cardWidths, "webp")}
                            sizes="(max-width: 767px) 100vw, (max-width: 1199px) 50vw, 25vw"
                          />
                          <source
                            srcset={buildSrcSet(item.image, cardWidths)}
                            sizes="(max-width: 767px) 100vw, (max-width: 1199px) 50vw, 25vw"
                          />
                          <img
                            src={appendImageParams(item.image, "w=480")}
                            srcset={buildSrcSet(item.image, cardWidths)}
                            sizes="(max-width: 767px) 100vw, (max-width: 1199px) 50vw, 25vw"
                            alt=""
                            width={800}
                            height={450}
                            loading="lazy"
                            decoding="async"
                          />
                        </picture>
                      </div>
                      <ul class="lb-blog__meta">
                        <li>
                          <time datetime={item.date.toISOString()}>
                            {formatDate(item.date)}
                          </time>
                        </li>
                        <li>{item.readingLabel}</li>
                      </ul>
                      <h3 class="lb-blog__title">{item.title}</h3>
                    </a>
                  </article>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <Tickets />
</BaseLayout>

<style>
  .blog__details-info :global(ul.blog__meta) {
    gap: 1.75rem 2rem;
    padding-bottom: 2rem;
    flex-wrap: wrap;
  }
  .blog__details-info :global(ul.blog__meta li) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    min-width: 0;
  }
  .blog__details-info :global(ul.blog__meta li::after) {
    inset-inline-end: -1rem;
  }
  .blog__details-info :global(.blog__meta-label) {
    display: block;
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--black-9);
  }
  .blog__details-info :global(.blog__meta-value),
  .blog__details-info :global(time.blog__meta-value) {
    display: block;
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--white);
  }
  :global(.light) .blog__details-info :global(.blog__meta-value),
  :global(.light) .blog__details-info :global(time.blog__meta-value) {
    color: var(--black-2);
  }
  .blog__details-info :global(.blog__details_title) {
    padding-bottom: 0.75rem;
  }
  .blog__details_subtitle {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 1.125rem;
    line-height: 1.6;
    margin-top: 0;
    margin-bottom: 2rem;
    font-weight: 500;
    opacity: 0.9;
    color: var(--black-9);
    max-width: 48ch;
  }
  .blog__details-hero-img {
    display: block;
    width: 100%;
    max-height: 400px;
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
  }
  @media only screen and (max-width: 767px) {
    .blog__details-info :global(ul.blog__meta) {
      gap: 1.1rem 1.5rem;
      padding-bottom: 1.5rem;
    }
    .blog__details_subtitle {
      font-size: 1.05rem;
      margin-bottom: 1.5rem;
    }
  }
  .lb-blog__card:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }
  .lb-post__services {
    margin-top: 3.5rem;
    padding: 32px 28px;
    border-radius: 8px;
    border: 1px solid var(--black-6);
  }
  :global(.light) .lb-post__services {
    border-color: var(--gray-13);
  }
  .lb-post__services-title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }
  .lb-post__services-text {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--black-9);
    margin-bottom: 1.5rem;
  }
  .lb-post__services-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lb-post__services-list li {
    list-style: none;
  }
  .lb-post__services-list a {
    display: block;
    height: 100%;
    padding: 18px 18px;
    border-radius: 8px;
    border: 1px solid var(--black-6);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }
  :global(.light) .lb-post__services-list a {
    border-color: var(--gray-13);
  }
  .lb-post__services-list a:hover,
  .lb-post__services-list a:focus-visible {
    border-color: var(--primary);
  }
  .lb-post__services-list a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }
  .lb-post__services-list strong {
    display: block;
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 0.4rem;
    color: var(--white);
  }
  :global(.light) .lb-post__services-list strong {
    color: var(--black-2);
  }
  .lb-post__services-list span {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--black-9);
  }
</style>
