---
import BaseLayout from "./Common.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Tickets from "../components/Tickets.astro";

import { getInsights, getServices } from "../content/config";
import type { InsightKey } from "../constants/insights";
import { insightPath, insightsHubPath } from "../constants/insights";
import { servicePath } from "../constants/services";
import type { ServiceKey } from "../constants/services";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { absoluteUrl } from "../utils/seo";
import { buildBlogPosting, buildBreadcrumbs } from "../utils/jsonLd";
import type { UiLang } from "../utils/seo";

interface Props {
	title: string;
	subtitle: string;
	seoTitle: string;
	date: Date;
	updated?: Date;
	image: string;
	lang: UiLang;
	insightKey: InsightKey;
	relatedServices: ServiceKey[];
	wordCount?: number;
}

const {
	title,
	subtitle,
	seoTitle,
	date,
	updated,
	image,
	lang,
	insightKey,
	relatedServices: relatedServiceKeys,
	wordCount = 0,
} = Astro.props;

const currentLang = getLangFromUrl(Astro.url) as UiLang;
const t = useTranslations(currentLang);
const category = t("insights.category");

const hubPath = insightsHubPath(lang);
const canonicalUrl = absoluteUrl(insightPath(insightKey, lang));

const articleLd = buildBlogPosting({
	headline: title,
	description: subtitle,
	datePublished: date,
	dateModified: updated,
	image,
	url: canonicalUrl,
	inLanguage: lang,
	keywords: relatedServiceKeys,
	articleSection: category,
	wordCount,
});

const relatedServices = (await getServices(lang))
	.filter((service) => relatedServiceKeys.includes(service.data.key))
	.map((service) => ({
		title: service.data.title,
		tagline: service.data.tagline,
		href: servicePath(service.data.key, lang),
	}));

const otherInsights = (await getInsights(lang))
	.filter((entry) => entry.data.key !== insightKey)
	.slice(0, 3)
	.map((entry) => ({
		title: entry.data.title,
		subtitle: entry.data.subtitle,
		href: insightPath(entry.data.key, lang),
	}));

const jsonLdExtra = [
	articleLd,
	...buildBreadcrumbs([
		{ name: t("nav.home"), url: absoluteUrl(`/${lang}`) },
		{ name: t("nav.insights"), url: absoluteUrl(hubPath) },
		{ name: title, url: canonicalUrl },
	]),
];
---

<BaseLayout
  title={seoTitle}
  description={subtitle}
  ogImage={image}
  ogType="article"
  canonical={canonicalUrl}
  articlePublishedTime={date.toISOString()}
  articleModifiedTime={(updated ?? date).toISOString()}
  articleSection={category}
  keywords={relatedServiceKeys}
  jsonLdExtra={jsonLdExtra}
>
  <article class="lb-insight pt-120 pb-100">
    <div class="container">
      <Breadcrumbs
        items={[
          { name: t("nav.home"), href: `/${lang}` },
          { name: t("nav.insights"), href: hubPath },
          { name: title },
        ]}
      />

      <header class="lb-insight__header">
        <h1 class="lb-insight__title">{title}</h1>
        <p class="lb-insight__subtitle">{subtitle}</p>
      </header>

      <div class="lb-insight__body">
        <slot />
      </div>

      {
        relatedServices.length > 0 && (
          <aside class="lb-insight__services">
            <h2 class="lb-insight__services-title">{t("insights.services.title")}</h2>
            <p class="lb-insight__services-text">{t("insights.services.text")}</p>
            <ul class="lb-insight__services-list">
              {relatedServices.map((service) => (
                <li>
                  <a href={service.href}>
                    <strong>{service.title}</strong>
                    <span>{service.tagline}</span>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }

      {
        otherInsights.length > 0 && (
          <section class="lb-insight__related">
            <h2 class="lb-insight__related-eyebrow">{t("insights.related.eyebrow")}</h2>
            <h3 class="lb-insight__related-title">{t("insights.related.title")}</h3>
            <ul class="lb-insight__related-list">
              {otherInsights.map((item) => (
                <li>
                  <a href={item.href}>
                    <strong>{item.title}</strong>
                    <span>{item.subtitle}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </article>

  <Tickets />
</BaseLayout>

<style>
  .lb-insight__header {
    margin-bottom: 2.5rem;
  }

  .lb-insight__title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    color: var(--white);
    text-wrap: balance;
  }

  :global(.light) .lb-insight__title {
    color: var(--black-2);
  }

  .lb-insight__subtitle {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 1.125rem;
    line-height: 1.7;
    margin: 0;
    color: var(--gray-4);
    max-width: 62ch;
  }

  :global(.light) .lb-insight__subtitle {
    color: var(--gray);
  }

  /* Full container width - do not reuse blog `.blog__details` (68ch). */
  .lb-insight__body {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #d0d0d0;
  }

  :global(.light) .lb-insight__body {
    color: #3a3a3e;
  }

  .lb-insight__body :global(h2),
  .lb-insight__body :global(h3),
  .lb-insight__body :global(h4) {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--white);
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
  }

  :global(.light) .lb-insight__body :global(h2),
  :global(.light) .lb-insight__body :global(h3),
  :global(.light) .lb-insight__body :global(h4) {
    color: var(--black-2);
  }

  .lb-insight__body :global(h2) {
    font-size: 1.5rem;
  }

  .lb-insight__body :global(h3) {
    font-size: 1.25rem;
  }

  .lb-insight__body :global(p) {
    margin-bottom: 1.15rem;
  }

  .lb-insight__body :global(ul),
  .lb-insight__body :global(ol) {
    margin: 0 0 1.15rem;
    padding-inline-start: 1.35rem;
  }

  .lb-insight__body :global(li) {
    margin-bottom: 0.4rem;
  }

  .lb-insight__body :global(a) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .lb-insight__body :global(strong) {
    color: var(--white);
    font-weight: 600;
  }

  :global(.light) .lb-insight__body :global(strong) {
    color: var(--black-2);
  }

  .lb-insight__body :global(table) {
    display: table;
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    margin: 1.5rem 0 2.25rem;
    font-size: 0.94rem;
    line-height: 1.5;
    border: 1px solid var(--black-6);
    border-radius: 14px;
    overflow: hidden;
    background: var(--black-3);
    box-shadow: 0 14px 42px rgba(0, 0, 0, 0.3);
  }

  :global(.light) .lb-insight__body :global(table) {
    border-color: var(--gray-13);
    background: #fff;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.07);
  }

  .lb-insight__body :global(th),
  .lb-insight__body :global(td) {
    padding: 1.05rem 1.25rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--black-6);
    border-right: 1px solid var(--black-6);
    overflow-wrap: break-word;
    word-break: normal;
    hyphens: manual;
  }

  :global(.light) .lb-insight__body :global(th),
  :global(.light) .lb-insight__body :global(td) {
    border-bottom-color: var(--gray-13);
    border-right-color: var(--gray-13);
  }

  .lb-insight__body :global(th:last-child),
  .lb-insight__body :global(td:last-child) {
    border-right: none;
  }

  .lb-insight__body :global(thead th) {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--white);
    background: linear-gradient(180deg, #2c2c31 0%, #1f1f23 100%);
    border-bottom: 2px solid var(--primary);
    white-space: normal;
  }

  :global(.light) .lb-insight__body :global(thead th) {
    color: var(--black-2);
    background: linear-gradient(180deg, #f8f8f9 0%, #ececef 100%);
    border-bottom-color: var(--secondary);
  }

  .lb-insight__body :global(thead th:first-child) {
    background: linear-gradient(180deg, #252529 0%, #1a1a1e 100%);
  }

  :global(.light) .lb-insight__body :global(thead th:first-child) {
    background: linear-gradient(180deg, #f2f2f4 0%, #e6e6ea 100%);
  }

  .lb-insight__body :global(td) {
    color: #c9c9cd;
    background: var(--black-3);
  }

  :global(.light) .lb-insight__body :global(td) {
    color: #3a3a3e;
    background: #fff;
  }

  .lb-insight__body :global(tbody tr:last-child th),
  .lb-insight__body :global(tbody tr:last-child td) {
    border-bottom: none;
  }

  .lb-insight__body :global(tbody tr:nth-child(even) td) {
    background: #222226;
  }

  :global(.light) .lb-insight__body :global(tbody tr:nth-child(even) td) {
    background: #f7f7f8;
  }

  .lb-insight__body :global(tbody tr:hover td) {
    background: #2a2a2f;
  }

  :global(.light) .lb-insight__body :global(tbody tr:hover td) {
    background: #f1f1f3;
  }

  .lb-insight__body :global(th:first-child),
  .lb-insight__body :global(td:first-child) {
    width: 22%;
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
    color: var(--white);
    background: #1b1b1f;
  }

  :global(.light) .lb-insight__body :global(th:first-child),
  :global(.light) .lb-insight__body :global(td:first-child) {
    color: var(--black-2);
    background: #f0f0f2;
  }

  .lb-insight__body :global(tbody tr:nth-child(even) td:first-child),
  .lb-insight__body :global(tbody tr:hover td:first-child) {
    background: #1f1f23;
  }

  :global(.light) .lb-insight__body :global(tbody tr:nth-child(even) td:first-child),
  :global(.light) .lb-insight__body :global(tbody tr:hover td:first-child) {
    background: #e8e8eb;
  }

  .lb-insight__body :global(td:first-child strong),
  .lb-insight__body :global(th:first-child strong) {
    font-weight: 600;
    color: inherit;
  }

  .lb-insight__body :global(th:not(:first-child)),
  .lb-insight__body :global(td:not(:first-child)) {
    width: 39%;
  }

  @media only screen and (max-width: 991px) {
    .lb-insight__body :global(table) {
      display: block;
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      table-layout: auto;
      overscroll-behavior-x: contain;
    }

    .lb-insight__body :global(thead),
    .lb-insight__body :global(tbody) {
      display: table;
      width: 100%;
      min-width: 36rem;
      border-collapse: separate;
      border-spacing: 0;
    }

    .lb-insight__body :global(th:first-child),
    .lb-insight__body :global(td:first-child) {
      position: sticky;
      left: 0;
      z-index: 1;
      box-shadow: 4px 0 12px rgba(0, 0, 0, 0.18);
    }

    :global(.light) .lb-insight__body :global(th:first-child),
    :global(.light) .lb-insight__body :global(td:first-child) {
      box-shadow: 4px 0 12px rgba(0, 0, 0, 0.06);
    }
  }

  @media only screen and (max-width: 767px) {
    .lb-insight__body :global(table) {
      font-size: 0.86rem;
      border-radius: 12px;
      margin: 1.15rem 0 1.8rem;
    }

    .lb-insight__body :global(th),
    .lb-insight__body :global(td) {
      padding: 0.85rem 1rem;
    }

    .lb-insight__body :global(thead),
    .lb-insight__body :global(tbody) {
      min-width: 32rem;
    }
  }

  .lb-insight__services {
    margin-top: 3.5rem;
    padding: 32px 28px;
    border-radius: 8px;
    border: 1px solid var(--black-6);
  }

  :global(.light) .lb-insight__services {
    border-color: var(--gray-13);
  }

  .lb-insight__services-title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .lb-insight__services-text {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--black-9);
    margin-bottom: 1.5rem;
  }

  .lb-insight__services-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lb-insight__services-list li {
    list-style: none;
  }

  .lb-insight__services-list a {
    display: block;
    height: 100%;
    padding: 18px;
    border-radius: 8px;
    border: 1px solid var(--black-6);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  :global(.light) .lb-insight__services-list a {
    border-color: var(--gray-13);
  }

  .lb-insight__services-list a:hover,
  .lb-insight__services-list a:focus-visible {
    border-color: var(--primary);
  }

  .lb-insight__services-list a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }

  .lb-insight__services-list strong {
    display: block;
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 0.4rem;
    color: var(--white);
  }

  :global(.light) .lb-insight__services-list strong {
    color: var(--black-2);
  }

  .lb-insight__services-list span {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--black-9);
  }

  .lb-insight__related {
    margin-top: 4.5rem;
  }

  .lb-insight__related-eyebrow {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 0.75rem;
  }

  .lb-insight__related-title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    color: var(--white);
  }

  :global(.light) .lb-insight__related-title {
    color: var(--black-2);
  }

  .lb-insight__related-list {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lb-insight__related-list li {
    list-style: none;
  }

  .lb-insight__related-list a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .lb-insight__related-list a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }

  .lb-insight__related-list strong {
    display: block;
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
    color: var(--white);
  }

  .lb-insight__related-list a:hover strong,
  .lb-insight__related-list a:focus-visible strong {
    color: var(--primary);
  }

  :global(.light) .lb-insight__related-list strong {
    color: var(--black-2);
  }

  .lb-insight__related-list span {
    display: block;
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--black-9);
  }
</style>
