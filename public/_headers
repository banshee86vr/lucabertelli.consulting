  Link: </.well-known/api-catalog>; rel="api-catalog"

/api/openapi.yaml
  Content-Type: application/yaml

/api/docs.md
  Content-Type: text/markdown; charset=utf-8

/api/status.json
  Content-Type: application/json; charset=utf-8
